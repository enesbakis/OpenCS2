# ── CS2 Server Settings ──────────────────────────────────────────────
CS2_SERVERNAME=CS2 Server
CS2_PORT=27015
CS2_MAXPLAYERS=16
CS2_PASSWORD=
CS2_STARTMAP=de_dust2
CS2_GAMETYPE=0
CS2_GAMEMODE=1
CS2_MAPGROUP=mg_active

# ── Logging ──────────────────────────────────────────────────────────
# Set CS2_LOG_FILE=1 to write logs to file
CS2_LOG=on
CS2_LOG_FILE=1

# ── Steam Game Server Login Token (GSLT) ─────────────────────────────
# Obtain from https://steamcommunity.com/dev/managegameservers
# App ID: 730 (CS2) — anonymous connection attempted if empty
CS2_GSLT=

# ── RCON (must match the CS2 rcon_password cvar) ─────────────────────
RCON_PASSWORD=your_rcon_password_here

# ── Panel Settings ───────────────────────────────────────────────────
PANEL_PORT=5000
# Required. The panel refuses to start if this is empty, shorter than 16 characters,
# or a known placeholder. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# (or: openssl rand -hex 32)
SECRET_KEY=
PANEL_ADMIN_USER=admin
# Optional. If empty, a random admin password is generated on the first start and
# written to the panel log ONCE: docker compose logs panel | grep "generated password"
# Only used when the user database is empty; changing it later does NOT change the password.
PANEL_ADMIN_PASS=

# ── Server's publicly reachable IP address ───────────────────────────
SERVER_IP=127.0.0.1

# ── Security ─────────────────────────────────────────────────────────
# Set to true when the panel is served over HTTPS (reverse proxy); marks session cookies Secure
SESSION_COOKIE_SECURE=false
# Maximum size of a single file upload to the panel, in MB
MAX_UPLOAD_MB=1024
