# ── CS2 Server Settings ──────────────────────────────────────────────
CS2_SERVERNAME=CS2 Server
CS2_PORT=27015
CS2_MAXPLAYERS=16
CS2_PASSWORD=
CS2_STARTMAP=de_dust2
CS2_GAMETYPE=0
CS2_GAMEMODE=1
CS2_MAPGROUP=mg_active

# ── Logging ──────────────────────────────────────────────────────────
# Set CS2_LOG_FILE=1 to write logs to file
CS2_LOG=on
CS2_LOG_FILE=1

# ── Steam Game Server Login Token (GSLT) ─────────────────────────────
# Obtain from https://steamcommunity.com/dev/managegameservers
# App ID: 730 (CS2) — anonymous connection attempted if empty
CS2_GSLT=

# ── RCON (must match the CS2 rcon_password cvar) ─────────────────────
RCON_PASSWORD=your_rcon_password_here

# ── Panel Settings ───────────────────────────────────────────────────
PANEL_PORT=5000
# Use a long random value for security:
SECRET_KEY=change-this-to-a-long-random-secret-key
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASS=changeme

# ── Server's publicly reachable IP address ───────────────────────────
SERVER_IP=127.0.0.1
